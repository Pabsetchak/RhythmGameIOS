# ---------------------------------------------------------------------------
# Keep this repo small and reproducible.
#
# It matters more than usual here: the iOS build works by having pygame_ios
# shutil.copytree() the whole RhythmGame_iOS folder into the app bundle, so
# anything committed under it ends up shipping on the device.
# ---------------------------------------------------------------------------

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# Virtual environments
venv/
.venv/
env/

# PyInstaller output for the desktop build
build/
dist/
_internal/
*.exe

# JVM crash dumps that landed here
hs_err_pid*.log

# ---------------------------------------------------------------------------
# Unrelated to this project
# ---------------------------------------------------------------------------
# A separate agent-configuration toolkit that happens to live in this folder
# (~42 MB, 3150 files) and has nothing to do with the rhythm game.
ECC/

# Design and monetisation material for "Slap A Friend For Brainrots!", an
# unrelated Roblox project that shares this folder. This repo is public, so
# these stay local.
SlapAFriend_DesignDoc.md
SlapAFriend_GameDescription.md
GamepassIcons/

# ---------------------------------------------------------------------------
# User content
# ---------------------------------------------------------------------------
# Song audio: large, and generally music you don't own the rights to
# redistribute. Charts (.json) are kept - they're your work and they're tiny.
# On device you add songs through the Files app instead.
rhythms/*.mp3
rhythms/*.ogg
rhythms/*.wav
rhythms/*.m4a
rhythms/*.flac
**/rhythms/*.mp3
**/rhythms/*.ogg
**/rhythms/*.wav
**/rhythms/*.m4a
**/rhythms/*.flac

# Exported chart bundles
*.crchart

# Machine-specific settings; regenerated with defaults on first launch.
# Shipping one would seed a device with desktop audio-buffer values.
**/rhythms/SETTINGS.json

# Hit sounds are synthesized on first run, so there's no reason to ship them.
**/assets/hits_v*/

# ---------------------------------------------------------------------------
# Editor / OS noise
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
*.swp
.idea/

# Xcode template and project fetched/generated by pygame_ios; CI recreates
# these on every build.
RhythmGame_iOS/pygame-ios-template/
RhythmGame_iOS/pygame-ios/
*.xcuserstate
xcuserdata/

# Boot diagnostics written at runtime.
boot_log.txt
**/boot_log.txt
